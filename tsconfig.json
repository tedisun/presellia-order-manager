{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["src/modules/*"],
      "@components/*": ["src/components/*"],
      "@services/*": ["src/services/*"],
      "@config/*": ["src/config/*"],
      "@navigation/*": ["src/navigation/*"],
      "@app-types/*": ["src/types/*"],
      "@context/*":   ["src/context/*"]
    }
  }
}
