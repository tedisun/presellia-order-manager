{
  "expo": {
    "name": "Presellia Orders",
    "slug": "presellia-order-manager",
    "scheme": "presellia-orders",
    "version": "1.4.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tedisun.presellia.ordermanager"
    },
    "android": {
      "package": "com.tedisun.presellia.ordermanager",
      "versionCode": 2026071501,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "notification": {
      "color": "#6C63FF"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/cash_register.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71dc7ad9-2268-4048-af64-a1b55781fa9a"
      }
    },
    "owner": "tedisun"
  }
}
